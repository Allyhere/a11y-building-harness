{
  "name": "a11y-building-harness",
  "version": "0.1.0",
  "description": "Fail-closed axe-core checks against a live URL, plus compact APG cards over MCP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allyhere/a11y-building-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Allyhere/a11y-building-harness/issues"
  },
  "homepage": "https://github.com/Allyhere/a11y-building-harness#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "a11y-building-harness": "bin/cli.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin/cli.mjs",
    "bin/postinstall.mjs",
    "harness/allowed-url.mjs",
    "harness/axe-run.mjs",
    "harness/blueprints.json",
    "harness/blueprints.mjs",
    "harness/verify.mjs",
    "mcp/server.mjs",
    "AGENTS.md",
    "CONTEXT.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "verify": "node bin/cli.mjs verify",
    "mcp": "node bin/cli.mjs mcp",
    "get-blueprints": "node bin/cli.mjs get-blueprints",
    "test": "node --test bin/cli.test.mjs harness/verify.test.mjs harness/blueprints.test.mjs harness/allowed-url.test.mjs harness/axe-run.test.mjs",
    "postinstall": "node bin/postinstall.mjs",
    "prepack": "node --check bin/cli.mjs && node --check mcp/server.mjs && node --check harness/allowed-url.mjs"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "axe-core",
    "mcp",
    "wcag",
    "playwright"
  ],
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "playwright": "1.63.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5"
  }
}
